<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vraie application : échanges avec le serveur central (D-129). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Positions de la navigation et du SOS, demandées au moment où elles
         servent (RG-AND-02, étude des autorisations Android n° 1). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Positions automatiques écran éteint : service de premier plan de type
         « location » (service de geolocator), avec sa notification permanente
         et un verrou de réveil (étude des autorisations Android n° 3 et 4,
         RG-AND-05). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- « Vocal » : micro, demandé au premier enregistrement (n° 8). « Photo »
         ouvre l'appareil photo du téléphone, sans autorisation CAMERA
         (RG-AND-06). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- SMS SOS et SMS de positions automatiques envoyés automatiquement
         (RG-SOS-16, RG-SMS-03, n° 5), demandée au démarrage d'une navigation
         après une explication ; soumise à l'exception « urgence » de Google
         Play (D-48, D-82). Les autres SMS s'ouvrent préremplis. -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <!-- Notification de la navigation en cours et du service de localisation
         (Android 13 et plus). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Exclusion de l'optimisation de la batterie (RG-GPS-05, D-52). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Notification après un redémarrage pendant une navigation (RG-NAV-12, D-51). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Le téléphone n'a pas besoin d'être un téléphone pour l'application :
         sans carte SIM, les SMS sont simplement indisponibles. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver
            android:name=".RedemarrageRecepteur"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fichiers"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- « Photo » : application appareil photo du téléphone (RG-AND-06). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- SMS SOS prérempli dans l'application SMS (RG-AND-04). -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <!-- MMS prérempli avec la photo (RG-SMS-05). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="image/jpeg"/>
        </intent>
        <!-- Ouvrir la page d'information sur l'abonnement (RG-ECO-10). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
